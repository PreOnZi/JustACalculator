<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background.

  This was the stock Android Studio template — a green #3DDC84 grid — wrapped in
  a group with android:scaleX="0" scaleY="0", so it collapsed to nothing and the
  launcher composited the foreground over an empty background. On Android 8+
  (which is every device the app targets) that is the whole icon, which is why
  it stopped reading as one.

  A solid fill in the icon's own background colour is what the layer is for: the
  launcher masks it to whatever shape the device uses, and the artwork in the
  foreground sits on top of a full-bleed ground rather than a hole.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#303030"
        android:pathData="M0,0h108v108h-108z"/>
</vector>
